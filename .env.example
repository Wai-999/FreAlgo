# FreAlgo environment template. Copy to `.env` for local development:
#   cp .env.example .env
# Never commit real secrets. Values below are placeholders or local-only development defaults.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public origin of the web app (used for absolute links, OIDC redirect, CSP decisions).
APP_BASE_URL=http://localhost:3000

# PostgreSQL 16+ connection string. The local default matches docker-compose.yml and only
# works against the container bound to 127.0.0.1.
DATABASE_URL=postgresql://frealgo:local_dev_only@localhost:5432/frealgo?schema=public
# Integration tests use a separate database (created by docker/postgres/init.sql).
DATABASE_URL_TEST=postgresql://frealgo:local_dev_only@localhost:5432/frealgo_test?schema=public

# Redis 7+/Valkey for BullMQ queues, locks and rate limits (maxmemory-policy must be noeviction).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# HMAC key for session cookies. REQUIRED in production (>= 32 chars).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Bearer token for the admin API (source management, manual re-fetch). Leave empty to disable
# token access. Generate with: openssl rand -base64 48
ADMIN_API_TOKEN=

# Comma-separated user IDs (as shown on /account) allowed to use the admin UI.
ADMIN_USER_IDS=dev:local-admin

# Local-only sign-in that creates a session for a named test identity without a password.
# Refused at startup when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# Optional OpenID Connect provider for real accounts (external gate: needs a provider account).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Data & demo mode
# ---------------------------------------------------------------------------
# Seed clearly-badged fixture outlets/articles for offline development and tests.
SEED_FIXTURES=true
# Show fixture rows in the UI/API (always badged "Fixture - not real news").
SHOW_FIXTURES=true

# ---------------------------------------------------------------------------
# Ingestion worker
# ---------------------------------------------------------------------------
# Scheduled fetch attempts: every 3 hours, UTC. One scheduler entry exists cluster-wide.
INGEST_CRON=0 */3 * * *
INGEST_TIMEOUT_MS=15000
INGEST_MAX_BYTES=5242880
INGEST_MAX_REDIRECTS=3
INGEST_WORKER_CONCURRENCY=4
INGEST_PER_HOST_CONCURRENCY=2
# Descriptive UA. You may append a contact URL for your deployment, e.g. "; +https://your.domain/about".
# Note: some publisher CDNs drop connections for UAs containing code-hosting URLs.
INGEST_USER_AGENT=FreAlgoFeedReader/0.1 (personal non-commercial reader)
# Days to keep ingestion runs, quarantine records and admin audit logs.
RETENTION_DAYS=90
# Port for the worker's internal /healthz and /metrics endpoint.
WORKER_HEALTH_PORT=9464

# ---------------------------------------------------------------------------
# Telemetry (aggregate counters only; no user identifiers)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
CLIENT_TELEMETRY_ENABLED=true
# Bearer token required to read /api/v1/metrics (Prometheus format). Empty = disabled.
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# FreAlgo 2.0 feature flags (lib/flags.ts). Unset = documented default; see /methodology#features.
# ---------------------------------------------------------------------------
# FEATURE_STORIES=true
# FEATURE_DISCOVER=true
# FEATURE_PERSPECTIVES=true
# FEATURE_MY_WORLD=true
# FEATURE_EVENT_CLUSTERING=true
# FEATURE_TIMELINES=true
# FEATURE_JOURNEYS=false          # needs curated, sourced journeys first
# FEATURE_WORLD_PULSE=false       # map shading by measured counts; off until reviewed
# FEATURE_COUNTRY_CONNECTIONS=false
# FEATURE_AI_SUMMARIES is locked off (not implemented)
