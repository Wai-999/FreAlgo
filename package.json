{
  "name": "frealgo",
  "version": "0.1.0",
  "private": true,
  "description": "Personal, ad-free, algorithm-free global news explorer",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx workers/index.ts",
    "worker:dev": "node --env-file-if-exists=.env --import tsx --watch workers/index.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "up": "docker compose up --build",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build",
    "postinstall": "prisma generate",
    "sources:activate": "node --env-file-if-exists=.env --import tsx scripts/activate-sources.ts",
    "sources:dry-run": "node --env-file-if-exists=.env --import tsx scripts/dry-run-feeds.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@react-three/fiber": "9.8.2",
    "bullmq": "5.81.5",
    "d3-geo": "3.1.1",
    "fast-xml-parser": "5.11.2",
    "ioredis": "5.11.1",
    "ipaddr.js": "2.5.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "topojson-client": "3.1.0",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "cldr-core": "48.2.0",
    "cron-parser": "4.9.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "i18n-iso-countries": "7.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "world-atlas": "2.0.2"
  }
}
