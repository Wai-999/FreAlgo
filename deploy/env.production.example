# Production secrets for deploy/docker-compose.prod.yml. Copy to deploy/.env.production and fill in.
# Generate secrets with: openssl rand -base64 48
DOMAIN=news.example.org
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
ADMIN_API_TOKEN=
ADMIN_USER_IDS=
METRICS_TOKEN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# FreAlgo 2.0 feature flags (docs/release/rollout-plan.md). Leave empty for the built-in default:
# on = stories, discover, perspectives, my world, event clustering, timelines;
# off = journeys, world pulse, country connections. AI summaries cannot be enabled.
FEATURE_STORIES=
FEATURE_DISCOVER=
FEATURE_PERSPECTIVES=
FEATURE_MY_WORLD=
FEATURE_EVENT_CLUSTERING=
FEATURE_TIMELINES=
FEATURE_JOURNEYS=
FEATURE_WORLD_PULSE=
FEATURE_COUNTRY_CONNECTIONS=
